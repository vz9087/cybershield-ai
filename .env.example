# ==============================================================================
# CyberShield AI — Environment Configuration Template
# Copy this file to .env for local configuration. Never commit real credentials.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# Database Connection (MySQL 8.0+)
# Example: mysql://<user>:<password>@127.0.0.1:3306/<database>
# If MySQL is not running, CyberShield will operate in resilient local mode with in-memory persistence.
DATABASE_URL=mysql://root:password@127.0.0.1:3306/cybershield

# Application & Token Security
APP_ID=cybershield-ai
# Generate a secure 32+ character signing key for JWT session cookies
JWT_SECRET=cybershield-ai-production-jwt-token-secret-key-2026-cseresearch

# Administrator Initial Setup Credentials
# The 3 authorized administrator identities are seeded automatically on startup:
# 1. Keerthi Manjunath Geddappanavar (karbasamamg@gmail.com)
# 2. Vishal VP (vishalvpurshan360@gmail.com)
# 3. Pooja N Annigere (annigerep@gmail.com)
ADMIN_KEERTHI_PASSWORD=Keerthi@1234
ADMIN_VISHAL_PASSWORD=Vishal@1234
ADMIN_POOJA_PASSWORD=Pooja@1234

# Optional: Transactional Email / SMTP Provider
# When unconfigured, notifications are logged safely to the in-app notification center and security outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@cybershield.ai

# Optional: External Threat Intelligence APIs
# The system includes internal deterministic rule engines and an offline threat database.
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
